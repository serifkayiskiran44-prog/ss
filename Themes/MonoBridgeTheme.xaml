<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="MonoCanvasBrush" Color="#F3F6F8"/>
    <SolidColorBrush x:Key="MonoSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MonoSurfaceMutedBrush" Color="#EAF0F3"/>
    <SolidColorBrush x:Key="MonoNavigationBrush" Color="#17313D"/>
    <SolidColorBrush x:Key="MonoNavigationSelectedBrush" Color="#245766"/>
    <SolidColorBrush x:Key="MonoPrimaryBrush" Color="#147A83"/>
    <SolidColorBrush x:Key="MonoPrimaryHoverBrush" Color="#0F646C"/>
    <SolidColorBrush x:Key="MonoBorderBrush" Color="#CFD9DF"/>
    <SolidColorBrush x:Key="MonoTextBrush" Color="#17313D"/>
    <SolidColorBrush x:Key="MonoMutedTextBrush" Color="#5F7480"/>
    <SolidColorBrush x:Key="MonoSuccessBrush" Color="#2D7D5A"/>
    <SolidColorBrush x:Key="MonoWarningBrush" Color="#B46D12"/>
    <SolidColorBrush x:Key="MonoErrorBrush" Color="#B43A3A"/>
    <SolidColorBrush x:Key="MonoInfoBrush" Color="#2F6F9F"/>

    <Style TargetType="Button">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Background" Value="{StaticResource MonoSurfaceMutedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource MonoTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MonoBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource MonoPrimaryBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource MonoPrimaryBrush}"/></Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"/>
    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="9,4"/></Style>
    <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="25"/><Setter Property="Padding" Value="8,2"/><Setter Property="Margin" Value="2"/></Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource MonoErrorBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource MonoErrorBrush}"/></Style>

    <Style TargetType="TextBox"><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="30"/><Setter Property="Background" Value="{StaticResource MonoSurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource MonoTextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource MonoBorderBrush}"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Padding" Value="7,4"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="30"/><Setter Property="BorderBrush" Value="{StaticResource MonoBorderBrush}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,3"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="30"/><Setter Property="BorderBrush" Value="{StaticResource MonoBorderBrush}"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="5,6"/><Setter Property="Foreground" Value="{StaticResource MonoTextBrush}"/></Style>

    <Style x:Key="CompactDataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Background" Value="{StaticResource MonoSurfaceBrush}"/><Setter Property="AlternatingRowBackground" Value="#F7F9FA"/><Setter Property="RowHeight" Value="29"/>
        <Setter Property="GridLinesVisibility" Value="All"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource MonoBorderBrush}"/><Setter Property="VerticalGridLinesBrush" Value="#E1E8EC"/>
        <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="False"/><Setter Property="BorderBrush" Value="{StaticResource MonoBorderBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="SelectionUnit" Value="FullRow"/>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource CompactDataGridStyle}"/>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="7,6"/><Setter Property="Background" Value="{StaticResource MonoSurfaceMutedBrush}"/><Setter Property="Foreground" Value="{StaticResource MonoTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="{StaticResource MonoBorderBrush}"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="7"/><Setter Property="BorderBrush" Value="{StaticResource MonoBorderBrush}"/><Setter Property="Foreground" Value="{StaticResource MonoTextBrush}"/></Style>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="12,6"/><Setter Property="Foreground" Value="{StaticResource MonoTextBrush}"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource MonoTextBrush}"/></Style>
    <Style x:Key="NavigationItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="7,1"/><Setter Property="Foreground" Value="#D7E2E7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource MonoNavigationSelectedBrush}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#234652"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- #857: the semantic tokens every screen shares: spacing, control paddings and heights, borders, radii.
         Device-independent values, identical to what the styles and panels used before the tokens existed, so
         nothing moves on screen. App.xaml and MainWindow.xaml merge this one file; DesignTokens.cs reads it and
         verifies it at startup. Typography is #858, the full spacing migration #859. -->

    <!-- Spacing scale -->
    <sys:Double x:Key="SpaceHairline">2</sys:Double>
    <sys:Double x:Key="SpaceInline">4</sys:Double>
    <sys:Double x:Key="SpaceControl">8</sys:Double>
    <sys:Double x:Key="SpaceSection">12</sys:Double>
    <sys:Double x:Key="SpacePage">20</sys:Double>

    <!-- Control paddings and margins -->
    <Thickness x:Key="ControlMargin">3</Thickness>
    <Thickness x:Key="InputPadding">7,5</Thickness>
    <Thickness x:Key="ButtonPadding">13,8</Thickness>
    <Thickness x:Key="CompactButtonPadding">10,5</Thickness>
    <Thickness x:Key="CardPadding">10</Thickness>
    <Thickness x:Key="HeaderPadding">8,10</Thickness>
    <Thickness x:Key="TabPadding">16,9</Thickness>
    <Thickness x:Key="NavigationItemPadding">14,9</Thickness>
    <Thickness x:Key="NavigationItemMargin">8,2</Thickness>

    <!-- Spacing scale as margins (#859): page, section and inline on all sides; the chip padding; the three text-block rhythms. -->
    <Thickness x:Key="PageMargin">20</Thickness>
    <Thickness x:Key="SectionMargin">12</Thickness>
    <Thickness x:Key="InlineMargin">4</Thickness>
    <Thickness x:Key="ChipPadding">8,2</Thickness>
    <Thickness x:Key="TitleBlockMargin">4,8,4,12</Thickness>
    <Thickness x:Key="HintBlockMargin">4,8,4,8</Thickness>
    <Thickness x:Key="BodyBlockMargin">3,4,3,7</Thickness>

    <!-- Control heights -->
    <sys:Double x:Key="ControlMinHeight">30</sys:Double>
    <sys:Double x:Key="RowHeight">36</sys:Double>
    <sys:Double x:Key="HitTargetMinSize">24</sys:Double>

    <!-- Icons (#860): the app draws icons as text glyphs; a size per role and the square minimum of an icon button. -->
    <sys:Double x:Key="IconSizeInline">13</sys:Double>
    <sys:Double x:Key="IconSizeToolbar">16</sys:Double>
    <sys:Double x:Key="IconSizeNavigation">14</sys:Double>
    <sys:Double x:Key="IconButtonMinSize">26</sys:Double>
    <sys:Double x:Key="ToolbarButtonMinSize">32</sys:Double>

    <!-- Borders and radii -->
    <sys:Double x:Key="BorderHairline">1</sys:Double>
    <sys:Double x:Key="BorderEmphasis">2</sys:Double>
    <CornerRadius x:Key="CardRadius">6</CornerRadius>
    <CornerRadius x:Key="ShellRadius">7</CornerRadius>

    <!-- Focus (#861): one keyboard focus ring for every control, a dark outer stroke and a light inner stroke drawn outside the bounds. -->
    <Color x:Key="FocusRingColor">#173646</Color>
    <Color x:Key="FocusRingInnerColor">#FFFFFF</Color>
    <sys:Double x:Key="FocusRingThickness">2</sys:Double>
    <sys:Double x:Key="FocusRingInnerThickness">1</sys:Double>
    <Thickness x:Key="FocusRingMargin">-2</Thickness>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}"/>
    <SolidColorBrush x:Key="FocusRingInnerBrush" Color="{StaticResource FocusRingInnerColor}"/>
    <Style x:Key="KeyboardFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Rectangle x:Name="Outer" Margin="{StaticResource FocusRingMargin}" StrokeThickness="{StaticResource FocusRingThickness}" Stroke="{StaticResource FocusRingBrush}" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
                        <Rectangle x:Name="Inner" StrokeThickness="{StaticResource FocusRingInnerThickness}" Stroke="{StaticResource FocusRingInnerBrush}" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- High contrast: the system's text and window colours, the same shape. -->
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                            <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            <Setter TargetName="Inner" Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Semantic colours (#862): the audited pairs. Text on its surface reaches 4.5:1, a border or an icon 3:1; the ContrastAudit test keeps it so. -->
    <Color x:Key="TextPrimaryColor">#173646</Color>
    <Color x:Key="TextMutedColor">#57707D</Color>
    <Color x:Key="TextSecondaryColor">#627986</Color>
    <Color x:Key="WarningTextColor">#A05216</Color>
    <Color x:Key="AccentColor">#176B73</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFF</Color>
    <Color x:Key="PageBackgroundColor">#F3F5F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="RailBackgroundColor">#142D3A</Color>
    <Color x:Key="RailForegroundColor">#CEDCE5</Color>
    <Color x:Key="RailSelectedColor">#285662</Color>
    <Color x:Key="RailSubtitleColor">#92AFBC</Color>
    <Color x:Key="SelectedRowColor">#1B4F72</Color>
    <Color x:Key="SelectedRowForegroundColor">#FFFFFF</Color>
    <Color x:Key="SelectedRowInactiveColor">#D6E2EB</Color>
    <sys:Double x:Key="SelectedRowRuleThickness">3</sys:Double>
    <Thickness x:Key="SelectedRowRule">3,0,0,0</Thickness>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}"/>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="{StaticResource SelectedRowColor}"/>
    <SolidColorBrush x:Key="SelectedRowForegroundBrush" Color="{StaticResource SelectedRowForegroundColor}"/>
    <SolidColorBrush x:Key="SelectedRowInactiveBrush" Color="{StaticResource SelectedRowInactiveColor}"/>

    <!-- Typography scale (#858): one face for text, one for code and diagnostics; the roles' sizes and weights. -->
    <FontFamily x:Key="FontFamilyBody">Segoe UI</FontFamily>
    <FontFamily x:Key="FontFamilyMono">Consolas, Courier New</FontFamily>
    <FontWeight x:Key="FontWeightTitle">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightKpi">Bold</FontWeight>
    <sys:Double x:Key="TextPageTitleSize">25</sys:Double>
    <sys:Double x:Key="TextSectionTitleSize">20</sys:Double>
    <sys:Double x:Key="TextSubsectionTitleSize">16</sys:Double>
    <sys:Double x:Key="TextBodySize">13</sys:Double>
    <sys:Double x:Key="TextCaptionSize">11</sys:Double>
    <sys:Double x:Key="TextKpiSize">25</sys:Double>
    <sys:Double x:Key="TextMonoSize">13</sys:Double>

    <!-- Shared text styles: the roles as styles for XAML; TextStyles.cs applies the same roles in code. -->
    <Style x:Key="PageTitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource TextPageTitleSize}"/><Setter Property="FontWeight" Value="{StaticResource FontWeightTitle}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="SectionTitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource TextSectionTitleSize}"/><Setter Property="FontWeight" Value="{StaticResource FontWeightTitle}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="SubsectionTitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource TextSubsectionTitleSize}"/><Setter Property="FontWeight" Value="{StaticResource FontWeightTitle}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="BodyText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource TextBodySize}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="CaptionText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource TextCaptionSize}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="KpiText" TargetType="TextBlock"><Setter Property="FontSize" Value="{StaticResource TextKpiSize}"/><Setter Property="FontWeight" Value="{StaticResource FontWeightKpi}"/></Style>

    <!-- Shared layout styles (#859): a page root and a section root for XAML; Spacing.cs applies the same rhythm in code. -->
    <Style x:Key="PageRoot" TargetType="Panel"><Setter Property="Margin" Value="{StaticResource PageMargin}"/></Style>
    <Style x:Key="SectionRoot" TargetType="Panel"><Setter Property="Margin" Value="{StaticResource SectionMargin}"/></Style>

    <!-- Shared control styles (#863): one standard for every window and dialog. An input stands at the control height with the input padding; a button and a check box are at least the hit target; every control carries the keyboard ring; a grid row and a cell carry the selection highlight and rule. -->
    <Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/><Setter Property="MinHeight" Value="{StaticResource HitTargetMinSize}"/><Setter Property="MinWidth" Value="{StaticResource HitTargetMinSize}"/><Setter Property="Padding" Value="{StaticResource ButtonPadding}"/><Setter Property="Margin" Value="{StaticResource ControlMargin}"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="TextBox"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/><Setter Property="Padding" Value="{StaticResource InputPadding}"/><Setter Property="Margin" Value="{StaticResource ControlMargin}"/><Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/><Setter Property="BorderBrush" Value="#D7DFE7"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/><Setter Property="Padding" Value="{StaticResource InputPadding}"/><Setter Property="Margin" Value="{StaticResource ControlMargin}"/><Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/><Setter Property="Padding" Value="{StaticResource InputPadding}"/><Setter Property="Margin" Value="{StaticResource ControlMargin}"/><Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/></Style>
    <Style TargetType="DatePicker"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/><Setter Property="Padding" Value="{StaticResource InputPadding}"/><Setter Property="Margin" Value="{StaticResource ControlMargin}"/><Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/></Style>
    <Style TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/><Setter Property="Margin" Value="5,7"/><Setter Property="MinHeight" Value="{StaticResource HitTargetMinSize}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AlternatingRowBackground" Value="#F6F9FB"/><Setter Property="RowHeight" Value="{StaticResource RowHeight}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E8EDF2"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="False"/><Setter Property="BorderBrush" Value="#DCE3EA"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="{StaticResource HeaderPadding}"/><Setter Property="Background" Value="#EAF0F4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="{StaticResource CardPadding}"/><Setter Property="BorderBrush" Value="#DCE3EA"/></Style>
    <Style TargetType="TabItem"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/><Setter Property="Padding" Value="{StaticResource TabPadding}"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="{StaticResource SelectedRowBrush}"/><Setter Property="BorderThickness" Value="{StaticResource SelectedRowRule}"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource SelectedRowBrush}"/><Setter Property="Foreground" Value="{StaticResource SelectedRowForegroundBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SelectedRowBrush}"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True"/><Condition Property="Selector.IsSelectionActive" Value="False"/></MultiTrigger.Conditions><Setter Property="Background" Value="{StaticResource SelectedRowInactiveBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></MultiTrigger></Style.Triggers></Style>
</ResourceDictionary>

<Window x:Class="TrMarketplaceHubDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MonoBridge — Yönetim Merkezi" Width="1440" Height="900" MinWidth="960" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="13">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#176B73"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="30"/><Setter Property="BorderBrush" Value="#D7DFE7"/></Style>
 <Style TargetType="PasswordBox"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="30"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="30"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Margin" Value="5,7"/></Style>
 <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AlternatingRowBackground" Value="#F6F9FB"/><Setter Property="RowHeight" Value="36"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E8EDF2"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="False"/><Setter Property="BorderBrush" Value="#DCE3EA"/><Setter Property="HeadersVisibility" Value="Column"/></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="8,10"/><Setter Property="Background" Value="#EAF0F4"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style TargetType="GroupBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#DCE3EA"/></Style>
 <Style TargetType="TabItem"><Setter Property="Padding" Value="16,9"/></Style>
 <Style x:Key="NavigationItem" TargetType="ListBoxItem"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="8,2"/><Setter Property="Foreground" Value="#CEDCE5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#285662"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#244552"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#142D3A"><DockPanel>
  <StackPanel DockPanel.Dock="Top" Margin="22,24,15,23"><TextBlock Text="MONOBRIDGE" Foreground="White" FontWeight="Bold" FontSize="21"/><TextBlock Text="Ticaret yönetim merkezi" Foreground="#92AFBC" Margin="0,7,0,0"/></StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="Yerel çalışma alanı" Foreground="#92AFBC" Margin="22,15"/>
  <TextBox x:Name="NavigationSearchBox" DockPanel.Dock="Top" Margin="12,0,12,8" ToolTip="Menüde ara" Height="30"/>
  <ListBox x:Name="NavigationList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
 </DockPanel></Border>
 <DockPanel Grid.Column="1">
  <Border DockPanel.Dock="Top" Background="White" Padding="24,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*" MinWidth="240" MaxWidth="430"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BreadcrumbText" Text="Ana sayfa" Foreground="#718795" FontSize="11"/><TextBlock x:Name="PageTitle" Text="Ürün yönetimi" FontSize="25" FontWeight="SemiBold" Foreground="#173646"/><TextBlock x:Name="PageDescription" Margin="0,5,0,0" Foreground="#627986" TextWrapping="Wrap"/></StackPanel><DockPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="BackButton" DockPanel.Dock="Right" Content="‹ Geri" Click="Back_Click" IsEnabled="False"/><Button x:Name="GlobalSearchButton" DockPanel.Dock="Right" Content="Ara" Click="GlobalSearch_Click"/><TextBox x:Name="GlobalSearchBox" ToolTip="SKU, barkod, sipariş, listing veya mağaza ara (Ctrl+K)"/></DockPanel></Grid></Border>
  <StatusBar DockPanel.Dock="Bottom" Background="#EAF0F4" Padding="12,5"><TextBlock x:Name="StatusText" Text="Hazır" TextWrapping="Wrap"/></StatusBar>
  <Expander DockPanel.Dock="Bottom" Header="İşlem geçmişi" Background="White" Margin="16,0,16,8"><ListBox x:Name="LogList" Height="100" BorderThickness="0"/></Expander>
  <Border x:Name="ProductSummaryBar" DockPanel.Dock="Top" Background="White" Margin="16,12,16,10" Padding="12,5" CornerRadius="6"><DockPanel><Button DockPanel.Dock="Right" Content="Havuzu yenile" Click="Refresh_Click"/><TextBlock x:Name="SummaryText" Foreground="#4C6676" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
  <TabControl x:Name="ModuleTabs" Margin="16,0,16,12" Background="White" BorderThickness="0"><TabControl.Template><ControlTemplate TargetType="TabControl"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="8"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></ControlTemplate></TabControl.Template></TabControl>
 </DockPanel>
</Grid></Window>


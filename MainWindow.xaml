<Window x:Class="TrMarketplaceHubDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonoBridge — Yönetim Merkezi"
        Width="1440" Height="900" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MonoCanvasBrush}"
        Foreground="{DynamicResource MonoTextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/MonoBridgeTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource MonoNavigationBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,12,14">
                    <TextBlock Text="MONOBRIDGE" Foreground="White" FontWeight="Bold" FontSize="19"/>
                    <TextBlock Text="Operasyon merkezi" Foreground="#9CB2BC" Margin="0,4,0,0" FontSize="11"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Yerel ve güvenli çalışma" Foreground="#9CB2BC" Margin="18,11" FontSize="11"/>
                <TextBox x:Name="NavigationSearchBox" DockPanel.Dock="Top" Margin="10,0,10,7" ToolTip="Menüde ara" Height="30"/>
                <ListBox x:Name="NavigationList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" Background="{DynamicResource MonoCanvasBrush}">
            <Border x:Name="GlobalCommandBar" DockPanel.Dock="Top" Background="{DynamicResource MonoSurfaceBrush}" BorderBrush="{DynamicResource MonoBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="430" MinWidth="280"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Content="‹ Geri" Click="Back_Click" IsEnabled="False" Style="{StaticResource ToolbarButtonStyle}"/>
                    <TextBlock Grid.Column="1" Text="Ticaret operasyonları" VerticalAlignment="Center" Margin="9,0" FontWeight="SemiBold" Foreground="{DynamicResource MonoMutedTextBrush}"/>
                    <DockPanel Grid.Column="2">
                        <Button x:Name="GlobalSearchButton" DockPanel.Dock="Right" Content="Ara" Click="GlobalSearch_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        <TextBox x:Name="GlobalSearchBox" ToolTip="SKU, barkod, sipariş, listing veya mağaza ara (Ctrl+K)"/>
                    </DockPanel>
                </Grid>
            </Border>

            <Border x:Name="PageHeader" DockPanel.Dock="Top" Background="{DynamicResource MonoSurfaceBrush}" BorderBrush="{DynamicResource MonoBorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                <StackPanel>
                    <TextBlock x:Name="BreadcrumbText" Text="Ana sayfa" Foreground="{DynamicResource MonoMutedTextBrush}" FontSize="10"/>
                    <TextBlock x:Name="PageTitle" Text="Ürün yönetimi" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource MonoTextBrush}"/>
                    <TextBlock x:Name="PageDescription" Margin="0,2,0,0" Foreground="{DynamicResource MonoMutedTextBrush}" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
            </Border>

            <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource MonoSurfaceMutedBrush}" Padding="10,3">
                <TextBlock x:Name="StatusText" Text="Hazır" TextWrapping="Wrap"/>
            </StatusBar>
            <Expander DockPanel.Dock="Bottom" Header="İşlem geçmişi" IsExpanded="False" Background="{DynamicResource MonoSurfaceBrush}" Margin="10,0,10,6">
                <ListBox x:Name="LogList" Height="92" BorderThickness="0"/>
            </Expander>
            <Border x:Name="ProductSummaryBar" DockPanel.Dock="Top" Background="{DynamicResource MonoSurfaceBrush}" Margin="10,8,10,6" Padding="9,4" CornerRadius="4">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Havuzu yenile" Click="Refresh_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                    <TextBlock x:Name="SummaryText" Foreground="{DynamicResource MonoMutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Border x:Name="PageCommandHost" Margin="10,0,10,10" Background="{DynamicResource MonoSurfaceBrush}" BorderBrush="{DynamicResource MonoBorderBrush}" BorderThickness="1" CornerRadius="4">
                <TabControl x:Name="ModuleTabs" Background="Transparent" BorderThickness="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Border Background="{TemplateBinding Background}" Padding="5">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </ControlTemplate>
                    </TabControl.Template>
                </TabControl>
            </Border>
        </DockPanel>
    </Grid>
</Window>

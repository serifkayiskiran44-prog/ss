<Window x:Class="TrMarketplaceHubDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MonoBridge — Yönetim Merkezi" Width="1440" Height="900" MinWidth="1150" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#F3F5F9">
<Window.Resources>
 <ResourceDictionary>
 <!-- #857: the window merges the token file itself, so it resolves the same values with or without the application (a test host, a tool). -->
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/DesignTokens.xaml"/></ResourceDictionary.MergedDictionaries>
 <!-- #860: a toolbar icon button: the app's button, square, centred, the toolbar glyph size. -->
 <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="{StaticResource ToolbarButtonMinSize}"/><Setter Property="MinHeight" Value="{StaticResource ToolbarButtonMinSize}"/><Setter Property="FontSize" Value="{StaticResource IconSizeToolbar}"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,4"/></Style>
 <Style x:Key="NavigationItem" TargetType="ListBoxItem"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/><Setter Property="Padding" Value="{StaticResource NavigationItemPadding}"/><Setter Property="Margin" Value="{StaticResource NavigationItemMargin}"/><Setter Property="Foreground" Value="#CEDCE5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent" CornerRadius="{StaticResource CardRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#285662"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#244552"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </ResourceDictionary>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#142D3A"><DockPanel>
  <DockPanel DockPanel.Dock="Top" Margin="12,14,8,10" LastChildFill="True"><Button x:Name="SidebarToggle" DockPanel.Dock="Right" Content="☰" Style="{StaticResource ToolbarIconButton}" Margin="0" ToolTip="Menüyü daralt / genişlet (Ctrl+B)" AutomationProperties.Name="Menüyü daralt veya genişlet" Click="SidebarToggle_Click"/><StackPanel x:Name="SidebarBrand" Margin="10,6,0,0"><TextBlock x:Name="SidebarBrandTitle" Text="MONOBRIDGE" Foreground="White" FontWeight="Bold" FontSize="21"/><TextBlock x:Name="SidebarBrandSubtitle" Text="Ticaret yönetim merkezi" Foreground="#92AFBC" Margin="0,7,0,0"/></StackPanel></DockPanel>
  <TextBlock x:Name="SidebarFooter" DockPanel.Dock="Bottom" Text="Yerel çalışma alanı" Foreground="#92AFBC" Margin="22,15"/>
  <TextBox x:Name="NavigationSearchBox" DockPanel.Dock="Top" Margin="12,0,12,8" ToolTip="Menüde ara" Height="{StaticResource ControlMinHeight}"/>
  <ListBox x:Name="NavigationList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
 </DockPanel></Border>
 <GridSplitter x:Name="SidebarSplitter" Grid.Column="0" Width="4" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="#1E3A48" ShowsPreview="False" DragCompleted="SidebarSplitter_DragCompleted" Focusable="False"/>
 <DockPanel Grid.Column="1">
  <Border DockPanel.Dock="Top" Background="White" Padding="24,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BreadcrumbText" Text="Ana sayfa" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource CaptionText}"/><TextBlock x:Name="PageTitle" Text="Ürün yönetimi" Style="{StaticResource PageTitleText}" Foreground="{StaticResource TextPrimaryBrush}"/><TextBlock x:Name="PageDescription" Margin="0,5,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><DockPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="ForwardButton" DockPanel.Dock="Right" Content="İleri ›" Click="Forward_Click" IsEnabled="False"/><Button x:Name="BackButton" DockPanel.Dock="Right" Content="‹ Geri" Click="Back_Click" IsEnabled="False"/><Button x:Name="ShortcutsButton" DockPanel.Dock="Right" Content="?" Click="ShortcutsButton_Click" AutomationProperties.Name="Klavye kısayolları (F1)" Margin="0,0,6,0"/><Button x:Name="GlobalSearchButton" DockPanel.Dock="Right" Content="Ara" Click="GlobalSearch_Click"/><TextBox x:Name="GlobalSearchBox" ToolTip="SKU, barkod, sipariş, listing veya mağaza ara (Ctrl+K)"/></DockPanel></Grid></Border>
  <StatusBar DockPanel.Dock="Bottom" Background="#EAF0F4" Padding="12,5"><TextBlock x:Name="StatusText" Text="Hazır" TextWrapping="Wrap"/></StatusBar>
  <Expander DockPanel.Dock="Bottom" Header="İşlem geçmişi" Background="White" Margin="16,0,16,8"><ListBox x:Name="LogList" Height="100" BorderThickness="0"/></Expander>
  <Border DockPanel.Dock="Top" Background="White" Margin="16,12,16,10" Padding="12,5" CornerRadius="{StaticResource CardRadius}"><DockPanel><Button DockPanel.Dock="Right" Content="Havuzu yenile" Click="Refresh_Click"/><TextBlock x:Name="SummaryText" Foreground="#4C6676" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
  <Grid x:Name="ShellLayers">
  <TabControl x:Name="ModuleTabs" Margin="16,0,16,12" Background="White" BorderThickness="0"><TabControl.Template><ControlTemplate TargetType="TabControl"><Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource ShellRadius}" Padding="8"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></ControlTemplate></TabControl.Template></TabControl>
   <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top" Width="360" Margin="0,8,28,0" Panel.ZIndex="10" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="Bildirimler"/>
  </Grid>
 </DockPanel>
</Grid></Window>


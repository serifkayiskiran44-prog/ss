<Application x:Class="TrMarketplaceHubDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TrMarketplaceHubDesktop"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- #857: the one token file every window and dialog resolves against; verified in App.OnStartup. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DesignTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
